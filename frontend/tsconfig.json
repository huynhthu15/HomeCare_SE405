{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // Screens ported from legacy/ stay .jsx until their owner converts them; they are bundled but
    // not type-checked. New files are written in TypeScript.
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "paths": {
      "@homecare/shared": ["../packages/shared/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
