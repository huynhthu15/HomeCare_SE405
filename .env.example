# Copy to apps/api/.env for local development:  cp .env.example apps/api/.env
# All values below are LOCAL DEVELOPMENT defaults. Never reuse them in production.

NODE_ENV=development
APP_ROLE=api            # api | worker
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of browser origins allowed by CORS (web dev server, LB)
CORS_ORIGINS=http://127.0.0.1:3020,http://localhost:3020,http://localhost:8080

# PostgreSQL (infra/docker-compose.yml)
DATABASE_URL=postgresql://homecare:homecare@localhost:5432/homecare?schema=public

# Redis (rate limit store shared across replicas, cache, queues, Socket.IO adapter)
REDIS_URL=redis://localhost:6379

# JWT - generate real secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# Refresh token cookie (web clients). Secure=true behind HTTPS.
COOKIE_SECURE=false
