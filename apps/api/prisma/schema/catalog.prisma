// Module: catalog — owner TV2
// Service catalogue and pricing inputs. Prices are ALWAYS computed server-side from these rows.

enum ServiceDomain {
  CLEANING
  REPAIR
  APPLIANCE
}

model Service {
  id          String        @id @default(uuid(7)) @db.Uuid
  code        String        @unique
  domain      ServiceDomain
  title       String
  description String
  basePrice   Int           @map("base_price")
  durationMin Int           @map("duration_min")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  bookings Booking[]

  @@index([domain, isActive])
  @@map("services")
}

model AddOn {
  id       String  @id @default(uuid(7)) @db.Uuid
  code     String  @unique
  label    String
  price    Int
  isActive Boolean @default(true) @map("is_active")

  bookingAddOns BookingAddOn[]

  @@map("add_ons")
}

enum DiscountType {
  FIXED
  PERCENT
}

model Voucher {
  id           String       @id @default(uuid(7)) @db.Uuid
  code         String       @unique
  discountType DiscountType @map("discount_type")
  value        Int
  maxDiscount  Int?         @map("max_discount")
  minOrder     Int          @default(0) @map("min_order")
  startsAt     DateTime     @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime     @map("ends_at") @db.Timestamptz(3)
  usageLimit   Int?         @map("usage_limit")
  usedCount    Int          @default(0) @map("used_count")

  @@map("vouchers")
}
